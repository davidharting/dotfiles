font-family = "Iosevka Term Nerd Font"
font-style = Light
font-style-bold = SemiBold
font-style-italic = "Light Italic"
font-style-bold-italic = "SemiBold Italic"
macos-option-as-alt = true

# Use cmd +k as my tmux prefix by sending ctrl + b
# https://davidharting.com/notes/how-i-use-cmdk-as-my-tmux-prefix
keybind = cmd+k=text:\x02

window-padding-x = 0
window-padding-y = 0
window-padding-balance = false


theme = Dark+


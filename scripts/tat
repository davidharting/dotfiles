#!/bin/sh

# Attach to (or create) a tmux session for the current directory.
#
# If a session already exists for this directory, connect to it by name;
# otherwise connect by path so sesh creates it with the windows configured in
# sesh.toml.
#
# Why the split? sesh's config_wildcard strategy (matched by the ~/repos/**
# pattern) always treats a path connection as new and re-runs the startup window
# creation, so `sesh connect "$PWD"` appends the configured windows again on
# every reconnect instead of being idempotent. Connecting by *name* matches
# sesh's tmux strategy instead, which attaches idempotently (and picks
# switch-client vs attach on its own). The tmux lookup below maps the current
# directory to an existing session name without reimplementing sesh's naming, so
# worktree sessions keep their names.

target="$(pwd -P)"

existing="$(tmux list-sessions -F '#{session_path}	#{session_name}' 2>/dev/null \
  | awk -F'\t' -v p="$target" '$1 == p { print $2; exit }')"

if [ -n "$existing" ]; then
  exec sesh connect "$existing"
fi

exec sesh connect "$PWD"

#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: lineardir [ TEAM-KEY | team KEY ]

Create and print the scratch directory for a Linear issue.

Both forms accept any valid team prefix (at least two letters) followed by 1+ digits.
Input is case-insensitive and normalized to lowercase internally.

Examples:
  lineardir GROW-1234
  lineardir grow-1234
  lineardir GROW 1234
  lineardir grow 1234
EOF
}

if [[ $# -eq 2 ]]; then
  first_lower="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  if [[ ! "$first_lower" =~ ^[[:alpha:]]{2,}$ ]] || [[ ! "$2" =~ ^[0-9]+$ ]]; then
    printf 'Error: two arguments must be a team prefix and a numeric issue ID.\n\n' >&2
    usage
    exit 2
  fi
  issue_key="${first_lower}-$2"
elif [[ $# -eq 1 ]]; then
  issue_key="$1"
else
  printf 'Error: expected exactly one key or two arguments (team + number).\n\n' >&2
  usage
  exit 2
fi

if [[ ! "$issue_key" =~ ^[[:alpha:]]{2,}-[[:digit:]]+$ ]]; then
  printf 'Error: invalid issue key: %s\n\n' "$issue_key" >&2
  usage
  exit 2
fi

issue_key="$(printf '%s' "$issue_key" | tr '[:upper:]' '[:lower:]')"
dir="$HOME/repos/control-room/scratch/linear/$issue_key"

mkdir -p "$dir"
printf '%s\n' "$dir"

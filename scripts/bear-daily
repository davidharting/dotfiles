#!/usr/bin/env bash
set -euo pipefail

today=$(date +%Y-%m-%d)

# Read stdin up front so it's available after the find-or-create step
if [ -t 0 ]; then
  content=""
else
  content=$(cat)
fi

# Find existing daily note or create one with the date tag
bearcli create "$today" --tags "date" --if-not-exists --content "" > /dev/null

if [ -z "$content" ]; then
  bearcli open --title "$today"
else
  printf '%s' "$content" | bearcli append --title "$today"
fi

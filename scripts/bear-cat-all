#!/usr/bin/env bash
set -euo pipefail

# Print the content of every note matched by `bearcli list`, each prefixed
# with YAML frontmatter carrying its timestamps. The frontmatter block is
# the note boundary — there is no other separator.
# All arguments are passed through to `bearcli list`.

bearcli list "$@" --fields content,created,modified --format json \
  | jq -r 'map("---\ncreated: \(.created)\nmodified: \(.modified)\n---\n\n\(.content)") | join("\n\n")'
